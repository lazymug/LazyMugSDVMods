<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Keep source art out of the packaged/deployed mod. The mod only loads assets/art/*.png,
         the rarity frames assets/frames/{common,uncommon,rare,legendary}.png and cards.json.
         The category scene backgrounds and the per-card subject sources under
         assets/frames/<category>/ are inputs to tools/compose_art.py (already baked into
         assets/art), so ModBuildConfig should not bundle them. Patterns are regexes matched
         against the relative path (forward slashes). -->
    <IgnoreModFilePatterns>assets/frames/(field|pasture|mine|sea|saloon|night)[.]png, assets/frames/(animals|crops|fish|forage|minerals|monsters|specials|villagers)/, [.]DS_Store</IgnoreModFilePatterns>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.3.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Design/reference files: not part of the build output -->
  <ItemGroup>
    <None Remove="cards.xlsx" />
    <None Remove="wireframes.html" />
    <None Remove="RULES.md" />
    <None Remove="tools\**" />
    <None Remove="card-previews\**" />
  </ItemGroup>

  <!-- Deploy the Content Patcher pack (lives at the repo root, alongside this project)
       so the Abigail intro event is injected into Data/Events/Saloon. -->
  <Target Name="DeployContentPack" AfterTargets="PostBuildEvent" Condition="'$(GamePath)' != ''">
    <PropertyGroup>
      <VtCpSource>$(ProjectDir)../[CP] Valley Triad</VtCpSource>
      <VtCpDest>$(GamePath)/Mods/[CP] Valley Triad</VtCpDest>
    </PropertyGroup>
    <Message Text="Deploying [CP] Valley Triad -> $(VtCpDest)" Importance="high" />
    <Exec Command="rm -rf &quot;$(VtCpDest)&quot; &amp;&amp; mkdir -p &quot;$(VtCpDest)&quot; &amp;&amp; cp -R &quot;$(VtCpSource)/&quot;* &quot;$(VtCpDest)/&quot;" />
  </Target>
</Project>
